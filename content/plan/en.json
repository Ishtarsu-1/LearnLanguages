{
  "lang": "en",
  "note": "Programme de l'anglais (CONTENU-PIPELINE, lot C3). D'abord 3 textes « tout premiers pas » (mots transparents + ~50 mots les plus fréquents, v0.3 lot 3.1), puis le socle existant, puis les unités proposées par npm run plan:suggest -- --lang en.",
  "grammar_order": [
    {
      "id": "be-present",
      "label": "Être au présent (am, is, are)",
      "phase": 1,
      "detect": { "regex": "\\b(am|is|are|i'm|you're|it's|he's|she's|we're|they're|that's|isn't|aren't)\\b" }
    },
    {
      "id": "present-simple",
      "label": "Présent simple (I work, she works)",
      "phase": 1,
      "detect": { "regex": "\\b(do|does|don't|doesn't)\\b|\\b(he|she|it) [a-z]+s\\b" }
    },
    {
      "id": "can",
      "label": "Can / can't",
      "phase": 1,
      "detect": { "regex": "\\b(can|can't|cannot)\\b" }
    },
    {
      "id": "there-is",
      "label": "There is / there are",
      "phase": 1,
      "detect": { "regex": "\\bthere (is|are)\\b|\\bthere's\\b" }
    },
    {
      "id": "imperative",
      "label": "Impératif (Go, Don't…)",
      "phase": 1,
      "detect": { "regex": "(^|[.!?] )(let's|don't|please|go|come|take|look|wait|turn)\\b" }
    },
    {
      "id": "present-continuous",
      "label": "Présent continu (I'm eating)",
      "phase": 1,
      "detect": { "regex": "\\b(am|is|are|'m|'re|'s) [a-z]+ing\\b|(i'm|you're|we're|they're|he's|she's|it's) [a-z]+ing\\b" }
    },
    {
      "id": "past-simple",
      "label": "Prétérit (I went, I watched)",
      "phase": 1,
      "detect": { "regex": "\\b[a-z]+ed\\b|\\b(went|had|did|was|were|saw|came|got|made|took|said|ate|bought|met|told|thought)\\b" }
    },
    {
      "id": "going-to",
      "label": "Futur proche (going to)",
      "phase": 1,
      "detect": { "regex": "going to" }
    },
    {
      "id": "will",
      "label": "Futur avec will",
      "phase": 1,
      "detect": { "regex": "\\bwill\\b|'ll\\b|\\bwon't\\b" }
    },
    {
      "id": "would-like",
      "label": "Politesse : would like / I'd love",
      "phase": 1,
      "detect": { "regex": "would like|'d like|'d love|would you" }
    },
    {
      "id": "comparative",
      "label": "Comparatif (bigger than, more … than)",
      "phase": 2,
      "detect": { "regex": "\\b[a-z]+er than\\b|\\bmore [a-z]+ than\\b" }
    },
    {
      "id": "present-perfect",
      "label": "Present perfect (I have seen)",
      "phase": 2,
      "detect": { "regex": "\\b(have|has|'ve|haven't|hasn't) (been|seen|done|gone|had|eaten|[a-z]+ed)\\b" }
    }
  ],
