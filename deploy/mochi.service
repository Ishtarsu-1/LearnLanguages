# Service systemd de Mochi : démarre au boot, redémarre en cas de plantage.
#   sudo cp deploy/mochi.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now mochi        journal : journalctl -u mochi -f
[Unit]
Description=Mochi (apprendre l'anglais et le coréen)
After=network-online.target
Wants=network-online.target

[Service]
User=mochi
Group=mochi
WorkingDirectory=/opt/mochi
ExecStart=/usr/bin/node --env-file=/opt/mochi/.env server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Durcissement : le service ne peut écrire que dans data/ et content/ (publication depuis l'admin)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mochi/data /opt/mochi/content /opt/mochi/content.data.js
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
