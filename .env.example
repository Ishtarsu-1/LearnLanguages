# Copie ce fichier en .env (qui n'est jamais commité), puis remplis les valeurs.
# npm start le charge automatiquement.

# Moteur du correcteur IA (onglet Produire) : "claude" (API, payant) ou "ollama" (local, gratuit).
# Sans moteur disponible, le correcteur hors ligne prend le relais.
MOCHI_LLM_PROVIDER=claude

# Moteur claude : clé API (voir SETUP.md, section 3)
ANTHROPIC_API_KEY=

# Moteur ollama (voir SETUP.md, section 6 bis)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT_MS=180000

# Vraies voix (voir SETUP.md, section 6 ter). Sans elles : voix du navigateur.
# TTS_URL_EN=http://127.0.0.1:8880/v1
# TTS_VOICES_EN=af_heart,am_michael,bf_emma,bm_george
# TTS_URL_KO=http://127.0.0.1:8881/v1
# TTS_VOICES_KO=KR
# TTS_MODEL_KO=melotts
# TTS_URL_ZH=http://127.0.0.1:8880/v1      # chinois : voix mandarin de Kokoro (même conteneur)
# TTS_VOICES_ZH=zf_xiaobei,zf_xiaoxiao,zm_yunxi,zm_yunjian
# TTS_URL_RU=http://127.0.0.1:8883/v1      # russe : Piper (tools/piper_server.py)
# TTS_VOICES_RU=denis,dmitri               # seules voix russes Piper sous licence libre (voir SETUP.md)
# TTS_MODEL_RU=piper
# TTS_TIMEOUT_MS=15000            # délai max d'une génération
# Après chaque ajout de contenu : npm run tts:pregen (pré-génère tout l'audio)

# E-mails (mot de passe oublié, vérification). Sans clé : affichés dans le terminal. Voir SETUP.md 6 quater.
# RESEND_API_KEY=
# MAIL_FROM=Mochi <bonjour@ton-domaine.fr>
# FEEDBACK_TO=ton.adresse@exemple.fr   # reçoit les retours « Donner mon avis »
# PUBLIC_URL=https://ton-domaine.fr

# Facultatif
# MOCHI_MODEL=claude-opus-5-5     # modèle (défaut : claude-opus-5-5, ou qwen2.5:7b-instruct avec ollama)
# MOCHI_LLM_DAILY=30              # corrections max par compte et par jour
# MOCHI_LLM_GLOBAL_DAILY=500      # appels à l'IA max par jour, tout le site (au-delà : correcteur hors ligne)
# MOCHI_LLM=off                   # désactive complètement le correcteur
# PORT=8000
# DATA_DIR=./data
# COOKIE_SECURE=1                 # uniquement derrière HTTPS (active aussi HSTS)

# Mise en ligne derrière Caddy (voir SETUP.md, section 6 septies)
# NODE_ENV=production
# HOST=127.0.0.1                  # n'écoute que la machine elle-même (défaut en production)
# TRUST_PROXY=127.0.0.1,::1       # proxys de confiance : lit l'IP réelle dans X-Forwarded-For

# Notifications Discord des commits et récaps de fin de tâche (scripts/notify-discord.sh)
DISCORD_WEBHOOK_URL=

# Mini-CTF de la version portable (npm run portable -- --ctf) : tes drapeaux ici, jamais dans le code
# MOCHI_CTF_FLAG1=MOCHI{premiere moitie de la phrase}
# MOCHI_CTF_FLAG2=MOCHI{seconde moitie}
