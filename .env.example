# Copie ce fichier en .env (qui n'est jamais commité), puis remplis les valeurs.
# npm start le charge automatiquement.

# Clé API Claude pour le correcteur (onglet Produire). Sans elle, le correcteur hors ligne prend le relais.
ANTHROPIC_API_KEY=

# Facultatif
# MOCHI_MODEL=claude-opus-5-5     # modèle utilisé pour les corrections
# MOCHI_LLM_DAILY=60              # corrections max par compte et par jour
# MOCHI_LLM=off                   # désactive complètement le correcteur
# PORT=8000
# DATA_DIR=./data
# COOKIE_SECURE=1                 # uniquement derrière HTTPS
