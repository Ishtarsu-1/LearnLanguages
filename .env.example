# Copie ce fichier en .env (qui n'est jamais commité), puis remplis les valeurs.
# npm start le charge automatiquement.

# Moteur du correcteur IA (onglet Produire) : "claude" (API, payant) ou "ollama" (local, gratuit).
# Sans moteur disponible, le correcteur hors ligne prend le relais.
MOCHI_LLM_PROVIDER=claude

# Moteur claude : clé API (voir SETUP.md, section 3)
ANTHROPIC_API_KEY=

# Moteur ollama (voir SETUP.md, section 6 bis)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TIMEOUT_MS=180000

# Vraies voix (voir SETUP.md, section 6 ter). Sans elles : voix du navigateur.
# TTS_URL_EN=http://localhost:8880/v1
# TTS_VOICES_EN=af_heart,am_michael,bf_emma,bm_george
# TTS_URL_KO=http://127.0.0.1:8881/v1
# TTS_VOICES_KO=KR
# TTS_MODEL_KO=melotts

# Facultatif
# MOCHI_MODEL=claude-opus-5-5     # modèle (défaut : claude-opus-5-5, ou qwen2.5:7b-instruct avec ollama)
# MOCHI_LLM_DAILY=60              # corrections max par compte et par jour
# MOCHI_LLM=off                   # désactive complètement le correcteur
# PORT=8000
# DATA_DIR=./data
# COOKIE_SECURE=1                 # uniquement derrière HTTPS
