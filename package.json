{
  "name": "mochi",
  "version": "0.3.0",
  "private": true,
  "description": "Mochi : apprendre l'anglais et le coréen (voir PEDAGOGIE.md)",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node tests/run.js",
    "doctor": "node --env-file-if-exists=.env tools/doctor.js",
    "tts:pregen": "node --env-file-if-exists=.env tools/pregen-tts.js",
    "content:build": "node tools/content-build.js",
    "content:annotate": "node --env-file-if-exists=.env tools/annotate.js",
    "plan:suggest": "node tools/plan-suggest.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "zod": "^4.6.7"
  }
